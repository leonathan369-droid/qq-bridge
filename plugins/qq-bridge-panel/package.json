{
  "name": "qq-bridge-panel",
  "version": "0.3.0",
  "description": "QQ Bridge for macOS —— DSH 设置页里的 QQ 智能体控制中心：真实健康检查、一键启动、运行模式、QQ 专用模型与推理强度、控制台安全打开",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
