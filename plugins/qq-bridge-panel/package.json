{
  "name": "qq-bridge-panel",
  "version": "0.2.0-r3",
  "description": "QQ 桥接面板：DSH 设置页里查看桥接/LLBot 端口状态、启动与停止，并在端口就绪后一键打开控制台与 LLBot WebUI",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
